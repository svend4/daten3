# Root environment reference for svend4/daten3 (TravelHub Ultimate)
# Service-specific templates live in:
#   - travelhub-ultimate/.env.example (Docker Compose)
#   - travelhub-ultimate/backend/.env.example (Backend API + Prisma)
#   - travelhub-ultimate/frontend/.env.example (Vite Frontend)

# ===== RUNTIME =====
NODE_ENV=development
PORT=3000

# ===== POSTGRESQL & PRISMA (travelhub-ultimate/backend/prisma/schema.prisma) =====
POSTGRES_DB=travelhub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://postgres:change-me-in-production@localhost:5432/travelhub

# ===== REDIS =====
REDIS_URL=redis://localhost:6379

# ===== JWT AUTHENTICATION (required in production by env.validator.ts) =====
# Generate strong random secrets (e.g., openssl rand -base64 32)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== CORS & FRONTEND =====
# Comma-separated origins allowed by travelhub-ultimate/backend/src/config/index.ts
FRONTEND_URL=http://localhost:5173,http://localhost:3001
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# ===== OPTIONAL INTEGRATIONS (Backend) =====
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here
TRAVELPAYOUTS_MARKER=travelhub
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TravelHub <noreply@travelhub.com>
